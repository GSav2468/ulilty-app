#include <iostream>
using namespace std;

void showMenu() {
    cout << "\n--- Unit Converter ---\n";
    cout << "1. Celsius to Fahrenheit\n";
    cout << "2. Kilometres to Miles\n";
    cout << "3. Kilograms to Pounds\n";
    cout << "4. Exit\n";
    cout << "Choose an option: ";
}

float celsiusToFahrenheit(float celsius) {
    return (celsius * 9 / 5) + 32;
}

float kilometresToMiles(float kilometres) {
    return kilometres * 0.621371;
}

float kilogramsToPounds(float kilograms) {
    return kilograms * 2.20462;
}

int main() {
    int choice = 0;
    float value = 0;
    float result = 0;

    while (choice != 4) {
        showMenu();
        cin >> choice;

        if (choice == 1) {
            cout << "Enter temperature in Celsius: ";
            cin >> value;
            result = celsiusToFahrenheit(value);
            cout << value << " Celsius is " << result << " Fahrenheit.\n";

        } else if (choice == 2) {
            cout << "Enter distance in kilometres: ";
            cin >> value;
            result = kilometresToMiles(value);
            cout << value << " kilometres is " << result << " miles.\n";

        } else if (choice == 3) {
            cout << "Enter weight in kilograms: ";
            cin >> value;
            result = kilogramsToPounds(value);
            cout << value << " kilograms is " << result << " pounds.\n";

        } else if (choice == 4) {
            cout << "Thank you for using the Unit Converter. Goodbye!\n";

        } else {
            cout << "Invalid option. Please choose between 1 and 4.\n";
        }
    }

    return 0;
}
